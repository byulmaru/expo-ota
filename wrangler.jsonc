{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "expo-ota",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "expo-ota.byulmaru.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "expo-ota"
    }
  ]
}
