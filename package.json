{
  "name": "expo-ota",
  "version": "0.1.0",
  "description": "GitHub Action for publishing Expo Updates releases to Cloudflare R2.",
  "private": true,
  "scripts": {
    "build:action": "esbuild action/src/index.ts --bundle --format=cjs --platform=node --target=node24 --outfile=action/dist/index.cjs",
    "check:action": "tsc --noEmit -p action/tsconfig.json",
    "test:action": "vitest run --config action/vitest.config.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "26.5.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "zod": "4.4.3"
  }
}
